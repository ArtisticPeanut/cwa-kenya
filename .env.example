# Copy to .env and adjust for your environment.
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Production refuses to start if SECRET_KEY is empty, a known placeholder, or shorter than 32 chars.
SECRET_KEY=
FLASK_ENV=development
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cwa
MIN_VOTES_FOR_CONSENSUS=3
CONSENSUS_RATIO=0.66
AMBIGUITY_MARGIN=0.15
WTF_CSRF_ENABLED=1
JWT_EXPIRY_HOURS=12

# Rate limiting (login / password reset). Defaults to in-memory storage; point
# this at Redis when running multiple workers, e.g. redis://localhost:6379/0.
RATELIMIT_STORAGE_URI=memory://
# Set to 1 when behind a reverse proxy (Nginx, Heroku, Render, ...) so the real
# client IP and HTTPS scheme are detected.
TRUST_PROXY=0

# Email / verification & password-reset OTP
# Leave SMTP_HOST blank in development: one-time codes print to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_FROM=
MAIL_FROM_NAME=Cyber Words Africa
# HTTPS email API — use instead of SMTP on hosts that block outbound SMTP
# (e.g. Render's free plan, which blocks ports 25/465/587). Set exactly ONE key.
# Brevo: create an API key and verify a sender email (no domain needed).
BREVO_API_KEY=
# Resend: create an API key (a verified domain is required to send to others).
RESEND_API_KEY=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
