# Copy to .env and adjust for your environment.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cwa
MIN_VOTES_FOR_CONSENSUS=3
CONSENSUS_RATIO=0.66
AMBIGUITY_MARGIN=0.15
WTF_CSRF_ENABLED=1
JWT_EXPIRY_HOURS=12

# Email / password-reset OTP
# Leave SMTP_HOST blank in development: one-time codes print to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_FROM=
MAIL_FROM_NAME=Cyber Words Africa
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
